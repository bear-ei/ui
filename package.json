{
        "name": "@bearei/ui",
        "main": "expo-router/entry",
        "version": "1.0.0",
        "private": true,
        "module": "./dist/index.mjs",
        "react-native": "./index.ts",
        "author": "bearei <bear_ei@outlook.com>",
        "description": "Bearei ui for React Native and Web",
        "readmeFilename": "README.md",
