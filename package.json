		"react-native-reanimated": "^3.15.0",
		"react-native-safe-area-context": "^4.10.5",
		"react-native-svg": "^15.6.0"
	},
	"engines": {
		"node": ">=18"
	},
	"rnx-kit": {
		"kitType": "library",
		"alignDeps": {
			"requirements": {
				"development": [
					"react-native@0.75"
				],
				"production": [
					"react-native@0.75"
				]
			},
			"capabilities": [
				"animation",
				"babel-preset-react-native",
				"core",
				"core-android",
				"core-ios",
				"core/metro-config",
				"datetime-picker",
				"gestures",
				"jest",
				"react",
				"react-dom",
				"react-test-renderer",
				"safe-area",
				"storage",
				"svg"
			]
		}
	},
	"scripts": {
		"android": "react-native run-android",
		"build-storybook": "storybook build",
		"build": "yarn lint && yarn coverage && yarn run clean && yarn vite build",
		"check-dependencies": "rnx-align-deps",
		"clean": "yarn shx rm -rf dist",
		"coverage": "yarn test --coverage",
		"fix-dependencies": "rnx-align-deps --write",
		"fix": "eslint ./src --fix",
		"format": "prettier --write .",
		"ios": "react-native run-ios",
		"lint": "eslint ./src",
		"macos": "react-native run-macos",
		"publish": "yarn build && yarn npm publish --access public",
		"start": "react-native start",
		"storybook-generate": "sb-rn-get-stories --config-path .ondevice",
		"test": "cross-env TS_NODE_PROJECT=\"./tsconfig.jest.json\" jest --watchAll --detectOpenHandles",
		"web": "storybook dev -p 6006"
	},
	"packageManager": "yarn@4.5.0"
}
