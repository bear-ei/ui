{
    "name": "@bearei/material",
    "version": "0.0.1",
    "source": "./src/index.tsx",
    "react-native": "./src/index.tsx",
    "main": "./dist/commonjs/index.js",
    "module": "./dist/module/index.js",
    "types": "./dist/typescript/index.d.ts",
    "exports": {
        "types": "./dist/typescript/index.d.ts",
        "import": "./dist/module/index.js",
        "require": "./dist/commonjs/index.js"
    },
    "license": "UNLICENSED",
    "author": "bearei <bear_ei@outlook.com>",
    "description": "Bearei material",
    "repository": {
        "type": "git",
        "url": "https://github.com/bear-ei/material"
    },
    "bugs": {
        "url": "https://github.com/bear-ei/material/issues"
    },
    "scripts": {
        "android": "react-native run-android",
        "build-storybook": "storybook build",
        "build": "yarn lint && yarn run clean && yarn bob build",
        "check-dependencies": "rnx-align-deps",
        "clean": "yarn shx rm -rf dist",
        "fix-dependencies": "rnx-align-deps --write",
        "ios": "react-native run-ios",
        "fix": "eslint ./src --fix",
        "lint": "eslint ./src",
        "macos": "react-native run-macos",
        "publish": "yarn build && yarn npm publish --access public",
        "start": "react-native start",
        "storybook-generate": "sb-rn-get-stories --config-path .ondevice",
        "storybook:android": "STORYBOOK_ENABLED=true react-native run-android",
        "storybook:ios": "STORYBOOK_ENABLED=true react-native run-ios",
        "storybook:macos": "STORYBOOK_ENABLED=true react-native run-macos",
        "storybook:web": "storybook dev -p 6006",
        "storybook": "STORYBOOK_ENABLED=true react-native start",
        "test": "jest"
    },
    "dependencies": {
        "@bearei/material-token": "^0.0.1",
        "@material-symbols/svg-400": "^0.17.4",
        "class-validator": "^0.14.1",
        "immer": "^10.1.1",
        "mitt": "^3.0.1",
        "styled-components": "^6.1.11",
        "use-immer": "^0.9.0"
    },
    "devDependencies": {
        "@babel/core": "^7.20.0",
        "@babel/plugin-proposal-decorators": "^7.24.7",
        "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
        "@babel/preset-env": "^7.20.0",
        "@babel/preset-react": "^7.24.7",
        "@babel/runtime": "^7.20.0",
        "@react-native-async-storage/async-storage": "^1.22.3",
        "@react-native-community/datetimepicker": "^8.0.0",
        "@react-native-community/slider": "^4.5.0",
        "@react-native/babel-preset": "^0.74.0",
        "@react-native/eslint-config": "^0.74.87",
        "@react-native/metro-config": "^0.74.0",
        "@react-native/typescript-config": "^0.74.87",
        "@rnx-kit/align-deps": "^2.4.5",
        "@storybook/addon-actions": "^7.6.13",
        "@storybook/addon-controls": "^7.6.13",
        "@storybook/addon-essentials": "^7.6.13",
        "@storybook/addon-links": "^7.6.13",
        "@storybook/addon-ondevice-actions": "^7.6.15",
        "@storybook/addon-ondevice-backgrounds": "^7.6.15",
        "@storybook/addon-ondevice-controls": "^7.6.15",
        "@storybook/addon-ondevice-notes": "^7.6.15",
        "@storybook/addon-react-native-web": "^0.0.23",
        "@storybook/react": "^8.0.10",
        "@storybook/react-native": "^7.6.15",
        "@storybook/react-webpack5": "^7.6.13",
        "@storybook/testing-library": "^0.2.2",
        "@svgr/webpack": "^8.1.0",
        "@types/jest": "^29.2.1",
        "@types/react": "^18.2.6",
        "@types/react-test-renderer": "^18.0.7",
        "babel-jest": "^29.6.3",
        "babel-loader": "^8.2.4",
        "babel-plugin-react-docgen-typescript": "^1.5.1",
        "babel-plugin-react-native-web": "^0.19.10",
        "babel-plugin-transform-inline-environment-variables": "^0.4.4",
        "check-dependencies": "^2.0.0",
        "eslint": "^8.19.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.3",
        "jest": "^29.2.1",
        "prettier": "^3.2.5",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-native": "^0.74.0",
        "react-native-builder-bob": "^0.23.2",
        "react-native-macos": "^0.74.0",
        "react-native-reanimated": "^3.6.0",
        "react-native-safe-area-context": "^4.10.5",
        "react-native-svg": "^15.4.0",
        "react-native-svg-transformer": "^1.3.0",
        "react-native-web": "^0.19.10",
        "react-test-renderer": "^18.2.0",
        "shx": "^0.3.4",
        "storybook": "^7.6.13",
        "typescript": "^5.4.5",
        "typescript-eslint": "^8.1.0"
    },
    "engines": {
        "node": ">=18"
    },
    "files": [
        "src",
        "dist",
        "!**/__tests__",
        "!**/__fixtures__",
        "!**/__mocks__",
        "!**/App.tsx",
        "!**/App.style.tsx",
        "!**/*.stories.*",
        "!**/.ondevice"
    ],
    "react-native-builder-bob": {
        "source": "src",
        "output": "dist",
        "targets": [
            [
                "commonjs",
                {
                    "esm": true,
                    "sourceMaps": false
                }
            ],
            [
                "module",
                {
                    "esm": true,
                    "sourceMaps": false
                }
            ],
            [
                "typescript",
                {
                    "esm": true,
                    "sourceMaps": false
                }
            ]
        ],
        "exclude": [
            "**/__tests__",
            "**/__fixtures__",
            "**/__mocks__",
            "**/App.tsx",
            "**/App.style.tsx",
            "**/*.stories.*",
            "**/.ondevice"
        ]
    },
    "resolutions": {
        "react-docgen-typescript": "2.2.2"
    },
    "rnx-kit": {
        "kitType": "library",
        "alignDeps": {
            "requirements": {
                "development": [
                    "react-native@0.74"
                ],
                "production": [
                    "react-native@*"
                ]
            },
            "capabilities": [
                "animation",
                "babel-preset-react-native",
                "core",
                "core-android",
                "core-ios",
                "core-macos",
                "core/metro-config",
                "datetime-picker",
                "jest",
                "react",
                "react-dom",
                "react-test-renderer",
                "safe-area",
                "storage",
                "svg"
            ]
        }
    },
    "packageManager": "yarn@4.4.0",
    "peerDependencies": {
        "@react-native-async-storage/async-storage": "^1.15.8 || ^1.15.9 || ^1.15.16 || ^1.17.3 || ^1.17.7 || ^1.17.10 || ^1.17.11 || ^1.18.2 || ^1.22.0 || ^1.22.3",
        "@react-native-community/async-storage": "^1.12.1",
        "@react-native-community/datetimepicker": "^3.0.9 || ^3.4.6 || ^3.5.2 || ^6.0.2 || ^6.3.3 || ^6.4.2 || ^7.6.2 || ^8.0.0",
        "react": "16.9.0 || 16.11.0 || 16.13.1 || 17.0.1 || 17.0.2 || 18.0.0 || 18.1.0 || 18.2.0 || ^18.2.0",
        "react-dom": "16.9.0 || 16.11.0 || 16.13.1 || 17.0.1 || 17.0.2 || ^18.0.0 || ^18.1.0 || ^18.2.0",
        "react-native": "^0.61.5 || ^0.62.3 || ^0.63.2 || ^0.64.2 || ^0.65.0 || ^0.66.0 || ^0.67.0 || ^0.68.0 || ^0.69.0 || ^0.70.0 || ^0.71.0 || ^0.72.0 || ^0.73.0 || ^0.74.0 || ^0.75.0",
        "react-native-macos": "^0.61.0 || ^0.62.0 || ^0.63.0 || ^0.64.0 || ^0.65.0 || ^0.66.0 || ^0.67.0 || ^0.68.0 || ^0.69.0 || ^0.70.0 || ^0.71.0 || ^0.72.0 || ^0.73.0 || ^0.74.0 || ^0.75.0",
        "react-native-reanimated": "^1.13.3 || ^2.1.0 || ^2.2.1 || ^2.2.3 || ^2.2.4 || ^2.5.0 || ^2.9.0 || ^2.10.0 || ^2.14.1 || ^3.3.0 || ^3.6.0",
        "react-native-safe-area-context": "^3.1.9 || ^3.2.0 || ^4.3.1 || ^4.4.1 || ^4.5.1 || >=4.5.3 <4.8 || ^4.8.2 || ^4.10.5",
        "react-native-svg": "^12.1.1 || ^12.3.0 || ^13.14.0 || ^15.0.0 || ^15.4.0"
    }
}
